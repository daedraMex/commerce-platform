# Copy to backend/.env and adjust. Never commit backend/.env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://shop:shop@localhost:5432/shop

# Redis from docker-compose. Its host port defaults to 6379 and is set with
# REDIS_PORT when starting compose (e.g. REDIS_PORT=6380 docker compose up -d
# if 6379 is taken); keep the port here in sync with it.
REDIS_URL=redis://localhost:6380/0
