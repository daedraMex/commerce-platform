# Copy to backend/.env and adjust. Never commit backend/.env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://shop:shop@localhost:5432/shop

# Default port is 6379. If it is taken on your machine, start compose with a
# different REDIS_PORT (for example in a root .env file next to
# docker-compose.yml) and use that same port in your own backend/.env.
REDIS_URL=redis://localhost:6379/0

# Public product media. Cloudflare R2 is used when R2_BUCKET_NAME is set;
# otherwise development and tests use the local filesystem. MEDIA_BASE_URL is
# our own media domain, never an r2.dev URL.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_REGION_NAME=
MEDIA_BASE_URL=
