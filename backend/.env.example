# Copy to backend/.env and adjust. Never commit backend/.env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://shop:shop@localhost:5432/shop

# Default port is 6379. If it is taken on your machine, start compose with a
# different REDIS_PORT (for example in a root .env file next to
# docker-compose.yml) and use that same port in your own backend/.env.
REDIS_URL=redis://localhost:6379/0
