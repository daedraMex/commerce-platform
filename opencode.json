{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "opencode.json": "ask",
      "AGENTS.md": "ask",
      "CLAUDE.md": "ask"
    }
  },
  "agent": {
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "edit": "deny",
        "shell": "ask"
      }
    },
    "build": {
      "model": "deepseek/deepseek-flash",
      "permission": {
        "shell": {
          "*": "ask",
          "pytest*": "allow",
          "ruff *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git push*": "ask"
        }
      }
    },
    "reviewer": {
      "description": "Reviews diffs against AGENTS.md, GLOSSARY.md, the spec and the clean architecture rules. Reports problems; never edits files.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "edit": "deny"
      }
    }
  }
}