{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git *push*": "deny",
      "git *--force*": "deny",
      "git config*": "deny",
      "git merge*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny",
      "REVIEW.md": "deny",
      "opencode.json": "deny",
      "opencode.factory.json": "deny",
      ".github/*": "deny",
      "tools/factory/*": "deny",
      "docs/adr/*": "deny",
      ".pre-commit-config.yaml": "deny",
      "backend/scripts/*": "deny",
      "web/console/scripts/*": "deny",
      ".opencode/*": "deny",
      "*conftest.py": "deny",
      "*opencode*.json": "deny",
      "*opencode*.jsonc": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow"
    },
    "external_directory": {
      "*": "deny"
    },
    "task": {
      "*": "deny"
    },
    "question": "deny",
    "webfetch": "deny"
  }
}
