#!/bin/bash -p
# Creates backend/.cleanup-probe in one factory worktree, as factory-agent, so the
# preflight can prove the worktree cleanup removes agent-owned files (#140).
# Installed root-owned at /usr/local/lib/factory/cleanup-probe and run with
#   sudo -n -u factory-agent -- /usr/local/lib/factory/cleanup-probe <worktree>
# In sudoers, the * in /srv/factory/worktrees/* matches any argument, so this
# script checks the path itself. Its sudoers entry is NOSETENV, so sudo resets
# the environment, and -p ignores BASH_ENV, ENV, SHELLOPTS and imported
# functions. The checks are not a boundary against factory (it can already run
# code as factory-agent through check.sh); they keep a mistake from writing
# outside a worktree.
set -euo pipefail
PATH=/usr/bin:/bin

root=/srv/factory/worktrees

refuse() {
  echo "cleanup-probe: refusing: $1" >&2
  exit 2
}

[ "$#" -eq 1 ] || refuse "expected one worktree path, got $#"
worktree="$1"
case "$worktree" in
  "$root"/*) ;;
  *) refuse "$worktree is not under $root" ;;
esac
name="${worktree#"$root"/}"
case "$name" in
  "" | . | .. | */*) refuse "$worktree is not one worktree directly under $root" ;;
esac
[ ! -L "$worktree" ] && [ -d "$worktree" ] || refuse "$worktree is not a directory"
[ ! -L "$worktree/backend" ] && [ -d "$worktree/backend" ] \
  || refuse "$worktree/backend is not a directory"
# Resolve once and work from there, so a symlink swapped in after the checks
# cannot redirect the rename.
cd -P -- "$worktree/backend"
[ "$(pwd -P)" = "$worktree/backend" ] || refuse "$worktree/backend resolves elsewhere"
[ ! -e .cleanup-probe ] && [ ! -L .cleanup-probe ] \
  || refuse "$worktree/backend/.cleanup-probe already exists"

tmp="$(mktemp -d /tmp/cleanup-probe.XXXXXX)"
trap 'rm -rf "$tmp"' EXIT
probe="$tmp/.cleanup-probe"
mkdir -m 0770 "$probe"
chgrp "$(id -gn)" "$probe"
chmod 0770 "$probe"
printf 'cleanup probe\n' > "$probe/file"
chmod 0644 "$probe/file"
# -T: never move the probe inside a directory that appeared since the check.
mv -T -- "$probe" .cleanup-probe
