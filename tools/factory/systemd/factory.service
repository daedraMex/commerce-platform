[Unit]
Description=Night factory: implement agent-ready tickets and open draft PRs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/factory/secrets.env
WorkingDirectory=/srv/factory/repo/tools/factory
UMask=0007
ExecStart=/usr/local/bin/uv run factory
TimeoutStartSec=4h
