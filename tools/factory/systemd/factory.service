[Unit]
Description=Night factory: implement agent-ready tickets and open PRs ready for review
After=network-online.target
Wants=network-online.target

[Service]
# Type=oneshot keeps this run active until it exits, so systemd never starts
# another run while one is still going; a timer tick during a run is skipped.
Type=oneshot
EnvironmentFile=%h/factory/secrets.env
WorkingDirectory=/srv/factory/repo/tools/factory
UMask=0007
ExecStart=/usr/local/bin/uv run --locked factory
TimeoutStartSec=4h
